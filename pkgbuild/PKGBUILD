# Canonical install: ./bin/install from the repository root. It builds and
# installs this package, covering the omacards binary and the agent skill.
# `omacards skill install` is an alternative that refreshes only the skill.
pkgname=omacards
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first flashcards with FSRS review and endless cram for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'desktop-file-utils')
optdepends=('unzip: import Anki .apkg packages'
            'tectonic: render LaTeX math as SVG'
            'pdftocairo: convert rendered math to SVG'
            'pdflatex: render LaTeX math as PDF without Tectonic'
            'latex: render LaTeX math as DVI'
            'dvisvgm: convert rendered DVI math to SVG')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
  desktop-file-validate "$startdir/omacards.desktop"
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omacards "$pkgdir/usr/bin/omacards"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omacards.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omacards.svg"
  install -Dm644 "$startdir/omacards.desktop" "$pkgdir/usr/share/applications/omacards.desktop"
}
