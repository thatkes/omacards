#!/bin/sh
set -eu

# Pre-stage ticket worktrees from a proved base SHA. Each id is handled in turn
# so one bad checkout does not stop the rest of the pool from being prepared.
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

usage() {
    printf 'Usage: wave-ready <base-sha> --root DIR --suites MAP <id>...\n' >&2
}

report_error() {
    printf 'ERROR %s %s\n' "$1" "$2" >&2
    failures=$((failures + 1))
}

one_line() {
    printf '%s' "$1" | tr '\n' ' ' | sed 's/  */ /g'
}

# Fingerprint values collapse every whitespace run and the edges; one_line()
# only collapses spaces because it also formats error messages.
normalise_value() {
    printf '%s' "$1" | tr '\n' ' ' |
        sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

# The field order is also the order in which mismatches are reported.
fingerprint_fields=$(cat <<'EOF'
qmake -v
g++ --version
Qt version
fc-match 'Noto Sans Math'
QT_QPA_PLATFORM
locale
EOF
)

capture_fingerprint() {
    qmake_v=$(normalise_value "$(qmake -v 2>&1 || true)")
    compiler_v=$(normalise_value "$(g++ --version 2>&1 || true)")
    qt_v=$(normalise_value "$(qmake -query QT_VERSION 2>&1 || true)")
    font_v=$(normalise_value "$(fc-match 'Noto Sans Math' 2>&1 || true)")
    locale_v=$(normalise_value "$(locale 2>/dev/null || true)")
    printf '%s\t%s\n' \
        'qmake -v' "$qmake_v" \
        'g++ --version' "$compiler_v" \
        'Qt version' "$qt_v" \
        "fc-match 'Noto Sans Math'" "$font_v" \
        'QT_QPA_PLATFORM' "${QT_QPA_PLATFORM-}" \
        'locale' "$locale_v"
}

check_fingerprint() {
    path=$1
    actual=$(cd "$path" && capture_fingerprint)
    while IFS= read -r field; do
        [ -n "$field" ] || continue
        saved_line=$(awk -F '\t' -v key="$field" \
            '$1 == key { print; exit }' "$fingerprint")
        if [ -z "$saved_line" ]; then
            reason="toolchain fingerprint missing field: $field"
            return 1
        fi
        actual_line=$(printf '%s\n' "$actual" |
            awk -F '\t' -v key="$field" '$1 == key { print; exit }')
        if [ "$saved_line" != "$actual_line" ]; then
            reason="toolchain fingerprint mismatch: $field"
            return 1
        fi
    done <<EOF
$fingerprint_fields
EOF
    return 0
}

check_untracked() {
    path=$1
    if ! entries=$(git -C "$path" ls-files --others --exclude-standard 2>&1); then
        reason="cannot read untracked status: $(one_line "$entries")"
        return 1
    fi
    [ -n "$entries" ] || return 0
    while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        allowed=0
        while IFS= read -r local_path; do
            [ -n "$local_path" ] || continue
            case "$entry" in
                "$local_path"|"$local_path"/*) allowed=1; break ;;
            esac
        done <<EOF
$allowed_paths
EOF
        if [ "$allowed" -eq 0 ]; then
            reason="untracked file outside Local-only allowlist: $entry"
            return 1
        fi
    done <<EOF
$entries
EOF
    return 0
}

check_lint() {
    path=$1
    if ! output=$(cd "$path" && ./bin/lint 2>&1); then
        if [ -n "$output" ]; then
            reason="./bin/lint failed in worktree: $(one_line "$output")"
        else
            reason='./bin/lint failed in worktree'
        fi
        return 1
    fi
    return 0
}

base=
root=
suites=
ids=
failures=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --root)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            root=$2
            shift 2
            ;;
        --suites)
            [ "$#" -ge 2 ] || { usage; exit 2; }
            suites="${suites:+$suites
}$2"
            shift 2
            ;;
        --root=*)
            root=${1#--root=}
            shift
            ;;
        --suites=*)
            suites="${suites:+$suites
}${1#--suites=}"
            shift
            ;;
        -*)
            usage
            exit 2
            ;;
        *)
            if [ -z "$base" ]; then
                base=$1
            else
                ids="$ids $1"
            fi
            shift
            ;;
    esac
done

if [ -z "$base" ] || [ -z "$root" ] || [ -z "$suites" ] || [ -z "$ids" ]; then
    usage
    exit 2
fi
if [ ! -d "$root" ]; then
    printf 'ERROR worktree root is not a directory: %s\n' "$root" >&2
    exit 2
fi
root=$(CDPATH= cd -- "$root" && pwd -P)

expected=$(git -C "$ROOT" rev-parse --verify "$base^{commit}" 2>/dev/null || true)
if [ -z "$expected" ]; then
    printf 'ERROR unknown base SHA: %s\n' "$base" >&2
    exit 2
fi

. "$ROOT/bin/local-only-sync-paths.sh"
allowed_paths=$(local_only_sync_paths "$ROOT")

# One fingerprint per base: capture it on the first wave-ready run, then
# compare every proved worktree against that preflight environment.
short=$(git -C "$ROOT" rev-parse --short=7 "$expected")
fingerprint="$ROOT/build/equivalence/$short.fingerprint"
if [ ! -f "$fingerprint" ]; then
    mkdir -p "$(dirname -- "$fingerprint")"
    capture_fingerprint > "$fingerprint"
fi

# Commas separate suites inside a pair; whitespace and semicolons separate
# pairs. A token without '=' continues the preceding pair.
suite_map=$(awk '
    function add(token,    eq, key, value) {
        if (token == "") return
        eq = index(token, "=")
        if (eq == 0) {
            if (last == "") bad = 1
            else pairs[last] = pairs[last] "," token
            return
        }
        key = substr(token, 1, eq - 1)
        value = substr(token, eq + 1)
        sub(/^#/, "", key)
        if (key !~ /^[0-9]+$/ || value == "") bad = 1
        else {
            pairs[key] = value
            last = key
        }
    }
    {
        line = $0
        gsub(/[,;]/, " ", line)
        n = split(line, tokens, /[[:space:]]+/)
        for (i = 1; i <= n; i++) add(tokens[i])
    }
    END {
        if (bad) exit 1
        for (key in pairs) print key "\t" pairs[key]
    }
' <<EOF
$suites
EOF
) || {
    printf 'ERROR invalid --suites map\n' >&2
    exit 2
}

prove() {
    path=$1
    actual=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)
    if [ "$actual" != "$path" ]; then
        reason='worktree top level mismatch'
        return 1
    fi
    head=$(git -C "$path" rev-parse --verify HEAD 2>/dev/null || true)
    if [ "$head" != "$expected" ]; then
        reason='wrong HEAD'
        return 1
    fi
    if ! status=$(git -C "$path" status --porcelain --untracked-files=no 2>&1); then
        reason="cannot read tracked status: $(one_line "$status")"
        return 1
    fi
    if [ -n "$status" ]; then
        reason='dirty tracked checkout'
        return 1
    fi
    if ! check_fingerprint "$path"; then
        return 1
    fi
    if ! check_untracked "$path"; then
        return 1
    fi
    return 0
}

for raw in $ids; do
    id=$raw
    case "$id" in
        \#*) id=${id#\#} ;;
    esac
    case "$id" in
        ''|*[!0-9]*)
            report_error "$raw" 'invalid id'
            continue
            ;;
    esac
    name="ticket-$id"
    path="$root/$name"

    id_suites=$(printf '%s\n' "$suite_map" |
        awk -F '\t' -v key="$id" '$1 == key { print $2; exit }')
    if [ -z "$id_suites" ]; then
        report_error "$name" 'no suites mapping'
        continue
    fi

    if [ -d "$path" ]; then
        if ! prove "$path"; then
            report_error "$name" "$reason"
            continue
        fi
    elif [ -e "$path" ]; then
        report_error "$name" 'worktree path is not a directory'
        continue
    else
        branch_sha=$(git -C "$ROOT" rev-parse --verify --quiet \
            "refs/heads/$name" 2>/dev/null || true)
        if [ -n "$branch_sha" ] && [ "$branch_sha" != "$expected" ]; then
            report_error "$name" "branch $name exists at $branch_sha"
            continue
        fi
        if [ -n "$branch_sha" ]; then
            set -- worktree add "$path" "$name"
        else
            set -- worktree add -b "$name" "$path" "$expected"
        fi
        if ! create_output=$(git -C "$ROOT" "$@" 2>&1); then
            report_error "$name" \
                "cannot create worktree: $(one_line "$create_output")"
            continue
        fi
    fi

    if ! sync_output=$("$ROOT/bin/sync-worktree-local-docs" "$path" 2>&1); then
        report_error "$name" \
            "cannot sync local docs: $(one_line "$sync_output")"
        continue
    fi

    # Lint reads the synced local docs, so it belongs after the sync rather
    # than in the pre-sync prove() call above.
    if ! check_lint "$path"; then
        report_error "$name" "$reason"
        continue
    fi

    if ! prove "$path"; then
        report_error "$name" "$reason"
        continue
    fi
    printf '%s %s %s\n' "$name" "$path" "$id_suites"
done

if [ "$failures" -ne 0 ]; then
    exit 1
fi
exit 0
