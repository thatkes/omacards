#!/bin/sh
set -eu

# Validate a test log against the suite count announced by the test runner.
# bin/test prints the log first, then calls this script; CI gets the same guard.
if [ "$#" -ne 1 ]; then
    printf 'Usage: check-test-summary LOG\n' >&2
    exit 2
fi
log=$1
if [ ! -f "$log" ]; then
    printf 'No such test log: %s\n' "$log" >&2
    exit 2
fi

awk '
  /^OMACARDS_TEST_MODE: info$/ { info_mode = 1 }
  /^OMACARDS_TEST_SUITES: [0-9]+$/ { announced = $2; have_announcement = 1 }
  /^(FAIL|QFATAL)/ { failures = failures $0 "\n" }
  /^Totals:/ {
    passed += $2
    failed += $4
    skipped += $6
    blacklisted += $8
    suites++
  }
  END {
    printf "ALL: %d passed, %d failed, %d skipped, %d blacklisted across %d suites\n", passed, failed, skipped, blacklisted, suites
    bad = 0
    if (failures != "") {
      printf "\nFailures:\n%s", failures
      bad = 1
    }
    if (failed > 0) {
      printf "ERROR: %d failed tests in Totals lines\n", failed > "/dev/stderr"
      bad = 1
    }
    if (info_mode && (have_announcement || suites > 0)) {
      print "ERROR: info marker conflicts with suite results" > "/dev/stderr"
      bad = 1
    }
    if (!info_mode) {
      if (!have_announcement) {
        print "ERROR: test run did not report OMACARDS_TEST_SUITES" > "/dev/stderr"
        bad = 1
      } else if (announced != suites) {
        printf "ERROR: expected %d suites from OMACARDS_TEST_SUITES, saw %d Totals lines\n", announced, suites > "/dev/stderr"
        bad = 1
      }
    }
    exit bad
  }
' "$log"
