#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

# Extension convention: this runner only resolves the repo root and calls
# scripts. Each check belongs in an executable bin/check-<concern> script and
# each shell self-test in tests/. A new check adds one call here; keep the
# existing calls in their current order so their output order is unchanged.
# Do not add check logic to this file.

./bin/check-cli-contract
./bin/check-local-only-files
./bin/check-sync-worktree-local-docs
./bin/check-skill-install
./bin/check-package-skill-install
./tests/test_check_package_skill_install.sh
./tests/test_check_commit_subject.sh
./tests/test_check_commit_scope.sh
./tests/test_check_test_summary.sh
./tests/test_bin_test_log.sh
./tests/test_check_sync_worktree_local_docs.sh
./tests/test_check_ledger_open_ids.sh
./tests/test_wave_timing.sh
./tests/test_merge_backstop.sh
./tests/test_check_format.sh
./bin/check-format
./bin/check-doc-paths
./tests/test_check_doc_paths.sh
