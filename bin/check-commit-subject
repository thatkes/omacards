#!/bin/sh
set -eu

status=0

# Reverts use a typed subject: revert: "<original subject>". Keep the quoted
# original so readers can tell what was undone, but shorten the quoted text
# when it would push the subject over the 50-character cap.
types='feat fix chore style perf test refactor docs revert'

check_subject() {
    label=$1
    subject=$2
    count=$(printf '%s' "$subject" | awk '{ print length($0) }')
    if [ "$count" -gt 50 ]; then
        printf '%s: commit subject over 50 characters (%s)\n' "$label" "$count" >&2
        status=1
    fi


    case "$subject" in
        *': '*) ;;
        *)
            printf '%s: commit subject needs a type prefix (%s)\n' \
                "$label" "$types" >&2
            status=1
            return
            ;;
    esac

    type=${subject%%:*}
    description=${subject#*: }
    valid_type=0
    for candidate in $types; do
        if [ "$candidate" = "$type" ]; then
            valid_type=1
            break
        fi
    done
    if [ "$valid_type" -ne 1 ]; then
        printf "%s: unknown commit subject type '%s' (%s)\n" \
            "$label" "$type" "$types" >&2
        status=1
        return
    fi

    case "$description" in
        [ABCDEFGHIJKLMNOPQRSTUVWXYZ]*)
            printf '%s: commit subject description must start lowercase\n' \
                "$label" >&2
            status=1
            ;;
    esac
}

if [ "${1:-}" = "--stdin" ]; then
    line=0
    while IFS= read -r subject || [ -n "$subject" ]; do
        line=$((line + 1))
        [ -n "$subject" ] || continue
        check_subject "stdin line $line" "$subject"
    done
else
    if [ $# -lt 1 ]; then
        printf 'usage: %s <message-file|--stdin>\n' "$0" >&2
        exit 2
    fi
    subject=$(awk '
      /^#/ { next }
      /^[[:space:]]*$/ && !haveSubject { next }
      !haveSubject { print; haveSubject = 1 }
    ' "$1")
    [ -n "$subject" ] || exit 0
    check_subject "$1" "$subject"
fi

exit "$status"
