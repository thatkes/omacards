#!/bin/sh
set -eu

# Guard README, SKILL.md and command-help.txt as one command contract: every
# path appears in each document and every command's flags agree. Also require
# help metadata for registry paths that reach commandHelp(), check the README
# Layout block's path tokens against the filesystem, and require the cloze
# rules in the agent documents. The optional root argument also checks the
# teaching pages for numeric anchors; those pages are local-only docs, so the
# check lives in the self-test rather than the integration lint run.
# Parsing stays shallow: first fenced block after a heading, command paths
# followed by bracketed/angled arguments, and one layout-token matcher that
# also checks paths appearing after prose. Prose and bracket notation are
# ignored when comparing flags.

if [ "$#" -gt 1 ]; then
    printf 'Usage: %s [root]\n' "$0" >&2
    exit 2
fi

self_test=0
if [ "$#" -eq 1 ]; then
    self_test=1
fi
root=${1:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
root=$(CDPATH= cd -- "$root" && pwd)
cd "$root"

registry="$root/src/command-paths.txt"
readme="$root/README.md"
skill="$root/src/skill/SKILL.md"
help_metadata="$root/src/command-help.txt"

for file in "$registry" "$readme" "$skill"; do
    if [ ! -f "$file" ]; then
        printf 'Missing required file: %s\n' "$file" >&2
        exit 1
    fi
done

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
status=0
tab=$(printf '\t')
: > "$tmp/help-flags"

# Expand brace alternatives and simple globs, then require a filesystem
# match. Every brace alternative must match; a lone glob needs one match.
layout_token_matches() {
    token=$1
    case "$token" in
        *'{'*','*'}'*)
            prefix=${token%%\{*}
            remainder=${token#*\{}
            alternatives=${remainder%%\}*}
            suffix=${remainder#*\}}
            old_ifs=$IFS
            IFS=','
            set -- $alternatives
            IFS=$old_ifs
            for alternative in "$@"; do
                pattern="$prefix$alternative$suffix"
                found=0
                for match in $pattern; do
                    if [ -e "$match" ]; then
                        found=1
                        break
                    fi
                done
                if [ "$found" -eq 0 ]; then
                    return 1
                fi
            done
            ;;
        *)
            for match in $token; do
                if [ -e "$match" ]; then
                    return 0
                fi
            done
            return 1
            ;;
    esac
    return 0
}

# Print "<line>:<text>" for the first fenced block after an exact heading.
extract_block() {
    awk -v heading="$2" '
        { line = $0; sub(/[[:space:]]+$/, "", line) }
        !seen && line == heading { seen = 1; next }
        seen && /^[[:space:]]*```/ {
            if (!inside) { inside = 1; next }
            exit
        }
        seen && inside { print NR ":" $0 }
    ' "$1"
}

# Print "<source>:<line> + <path>" for known paths and
# "<source>:<line> ! <path>" for paths missing from the registry. Registry
# aliases in a trailing comment count as documented paths.
parse_commands() {
    awk -v source="$1" '
        FNR == NR { known[$0] = 1; next }
        {
            raw = $0
            lineno = raw
            sub(/:.*/, "", lineno)
            text = raw
            sub(/^[^:]*:/, "", text)
            sub(/^[[:space:]]+/, "", text)
            if (text == "" || text ~ /^#/ || text !~ /^omacards([[:space:]]|$)/)
                next

            comment = ""
            marker = match(text, /[[:space:]]#/)
            if (marker) {
                comment = substr(text, marker + 1)
                text = substr(text, 1, marker - 1)
            }
            sub(/[[:space:]]+$/, "", text)

            n = split(text, fields, /[[:space:]]+/)
            if (n < 2) next
            path = fields[2]
            unknown = 0
            for (i = 3; i <= n; i++) {
                word = fields[i]
                first = substr(word, 1, 1)
                if (first == "-" || first == "[" || first == "<" ||
                    first == "\"" || first == "\047" || first == "~") break
                candidate = path " " word
                path = candidate
                if (!known[candidate]) {
                    unknown = 1
                    break
                }
            }
            if (unknown || !known[path])
                print source ":" lineno " ! " path
            else
                print source ":" lineno " + " path

            if (comment != "") {
                gsub(/[,;]/, " ", comment)
                m = split(comment, words, /[[:space:]]+/)
                for (j = 1; j <= m; j++) {
                    alias = words[j]
                    if (alias ~ /^-/ && known[alias])
                        print source ":" lineno " + " alias
                }
            }
        }
    ' "$tmp/registry" "$2"
}

# Print "<path>\t<flag>" for each flag in a documentation command block.
# Brackets, value placeholders and help's global -h/--help tokens are dropped;
# -d and --deck are one flag family.
parse_command_flags() {
    awk '
        function canonical(flag) {
            gsub(/^[\[]+/, "", flag)
            gsub(/,$/, "", flag)
            gsub(/[\]]+$/, "", flag)
            if (substr(flag, 1, 1) != "-") return ""
            if (flag == "-h" || flag == "--help") return ""
            if (flag == "-d") return "--deck"
            return flag
        }
        FNR == NR { known[$0] = 1; next }
        {
            raw = $0
            text = raw
            sub(/^[^:]*:/, "", text)
            sub(/^[[:space:]]+/, "", text)
            if (text == "" || text ~ /^#/ || text !~ /^omacards([[:space:]]|$)/)
                next

            marker = match(text, /[[:space:]]#/)
            if (marker) text = substr(text, 1, marker - 1)
            sub(/[[:space:]]+$/, "", text)

            n = split(text, fields, /[[:space:]]+/)
            if (n < 2) next
            path = fields[2]
            if (!known[path]) next
            argstart = 3
            while (argstart <= n) {
                word = fields[argstart]
                first = substr(word, 1, 1)
                if (first == "-" || first == "[" || first == "<" ||
                    first == "\"" || first == "\047" || first == "~") break
                candidate = path " " word
                if (!known[candidate]) break
                path = candidate
                argstart++
            }
            if (!known[path]) next

            for (i = argstart; i <= n; i++) {
                word = fields[i]
                first = substr(word, 1, 1)
                if (first != "-" && first != "[") continue
                flag = canonical(word)
                if (flag == "") continue
                key = path SUBSEP flag
                if (!seen[key]++) print path "\t" flag
            }
        }
    ' "$tmp/registry" "$2"
}

command_has_flag() {
    awk -F '\t' -v path="$1" -v flag="$2" \
        '$1 == path && $2 == flag { found = 1 } END { exit !found }' "$3"
}

awk '{
    sub(/\r$/, "")
    gsub(/^[[:space:]]+|[[:space:]]+$/, "")
    if ($0 != "" && $0 !~ /^#/) print
}' "$registry" > "$tmp/registry"
if [ ! -s "$tmp/registry" ]; then
    printf 'Empty command-path registry: %s\n' "$registry" >&2
    exit 1
fi
sort -u "$tmp/registry" > "$tmp/registry.sorted"

extract_block "$readme" '## Agent CLI' > "$tmp/readme-cli.raw"
extract_block "$skill" '## Command list' > "$tmp/skill-cli.raw"
if [ ! -s "$tmp/readme-cli.raw" ]; then
    printf 'Missing fenced block after ## Agent CLI in %s\n' "$readme" >&2
    exit 1
fi
if [ ! -s "$tmp/skill-cli.raw" ]; then
    printf 'Missing fenced block after ## Command list in %s\n' "$skill" >&2
    exit 1
fi

parse_commands README.md "$tmp/readme-cli.raw" > "$tmp/readme-paths"
parse_commands SKILL.md "$tmp/skill-cli.raw" > "$tmp/skill-paths"
cat "$tmp/readme-paths" "$tmp/skill-paths" > "$tmp/all-paths"

awk '$2 == "!"' "$tmp/all-paths" > "$tmp/unknown-paths"
while IFS= read -r entry; do
    where=${entry%% *}
    rest=${entry#* }
    path=${rest#\! }
    printf '%s: command path not in src/command-paths.txt: %s\n' \
        "$where" "$path" >&2
    status=1
done < "$tmp/unknown-paths"

awk '$2 != "!" {
    path = $0
    sub(/^[^ ]+ [^ ]+ /, "", path)
    print path
}' "$tmp/all-paths" | sort -u > "$tmp/documented"
comm -23 "$tmp/registry.sorted" "$tmp/documented" > "$tmp/missing-paths"
while IFS= read -r path; do
    printf 'Registry command path not documented in README Agent CLI or skill Command list: %s\n' \
        "$path" >&2
    status=1
done < "$tmp/missing-paths"

# Help wording is a tracked resource read as text, so drift is caught without
# building the app. Fixtures that do not embed the resource keep the older
# doc-only contract; when the file exists, every block is checked in isolation
# and every registry path reaching commandHelp() must have a block. Registry
# tokens `help` or starting with `-` route to usage() via Cli::isHelpCommand()
# and are exempt.
if [ -f "$help_metadata" ]; then
    : > "$tmp/help-paths"
    awk -v paths_file="$tmp/help-paths" -v flags_file="$tmp/help-flags" '
        function canonical(flag) {
            gsub(/^[\[]+/, "", flag)
            gsub(/,$/, "", flag)
            gsub(/[\]]+$/, "", flag)
            if (substr(flag, 1, 1) != "-") return ""
            if (flag == "-h" || flag == "--help") return ""
            if (flag == "-d") return "--deck"
            return flag
        }
        function emit_flags(p, value,    n, words, i, flag, key) {
            gsub(/,/, " ", value)
            n = split(value, words, /[[:space:]]+/)
            for (i = 1; i <= n; i++) {
                flag = canonical(words[i])
                if (flag == "") continue
                key = p SUBSEP flag
                if (!flag_seen[key]++) print p "\t" flag > flags_file
            }
        }
        function finish(    p) {
            if (!has_path && !has_purpose && !has_flags && !has_example)
                return
            if (has_path) {
                p = path
                print p > paths_file
                if (seen[p]++)
                    printf "%d: duplicate help metadata path: %s\n", path_line, p
                if (!(p in known))
                    printf "%d: help metadata path not in src/command-paths.txt: %s\n", path_line, p
            } else {
                printf "%d: help metadata block without a path\n", block_line
            }
            if (has_purpose && purpose == "")
                printf "%d: empty help metadata field: Purpose\n", purpose_line
            if (has_flags && flags == "")
                printf "%d: empty help metadata field: Flags\n", flags_line
            if (has_example && example == "")
                printf "%d: empty help metadata field: Example\n", example_line
            if (!has_purpose)
                printf "%d: missing help metadata field: Purpose\n", block_line
            if (!has_flags)
                printf "%d: missing help metadata field: Flags\n", block_line
            if (!has_example)
                printf "%d: missing help metadata field: Example\n", block_line
            has_path = has_purpose = has_flags = has_example = 0
            path = purpose = flags = example = ""
            in_block = 0
        }
        FNR == NR { known[$0] = 1; next }
        {
            raw = $0
            sub(/\r$/, "", raw)
            if (raw ~ /^[[:space:]]*$/ || raw ~ /^[[:space:]]*#/) {
                if (in_block) finish()
                next
            }
            if (!in_block) {
                in_block = 1
                block_line = FNR
            }
            colon = index(raw, ":")
            if (colon == 0) {
                printf "%d: unexpected help metadata line: %s\n", FNR, raw
                next
            }
            field = substr(raw, 1, colon - 1)
            value = substr(raw, colon + 1)
            sub(/^[[:space:]]+/, "", value)
            sub(/[[:space:]]+$/, "", value)
            if (field == "Path") {
                if (has_path)
                    printf "%d: duplicate help metadata field: Path\n", FNR
                path = value
                path_line = FNR
                has_path = 1
            } else if (field == "Purpose") {
                purpose = value
                purpose_line = FNR
                has_purpose = 1
            } else if (field == "Flags") {
                flags = value
                flags_line = FNR
                has_flags = 1
                if (has_path) emit_flags(path, value)
            } else if (field == "Example") {
                example = value
                example_line = FNR
                has_example = 1
            } else {
                printf "%d: unknown help metadata field: %s\n", FNR, field
            }
        }
        END { if (in_block) finish() }
    ' "$tmp/registry" "$help_metadata" > "$tmp/help-errors"
    while IFS= read -r error; do
        line=${error%%:*}
        text=${error#*: }
        printf 'src/command-help.txt:%s: %s\n' "$line" "$text" >&2
        status=1
    done < "$tmp/help-errors"

    sort -u "$tmp/help-paths" > "$tmp/help-paths.sorted"
    awk '
        {
            token = $1
            if (token == "help" || substr(token, 1, 1) == "-")
                next
            print
        }
    ' "$tmp/registry" | sort -u > "$tmp/help-required-paths"
    comm -23 "$tmp/help-required-paths" "$tmp/help-paths.sorted" > "$tmp/help-missing-paths"
    while IFS= read -r path; do
        printf 'src/command-help.txt: missing help metadata for command path: %s\n' "$path" >&2
        status=1
    done < "$tmp/help-missing-paths"
fi

# Treat the README block, the skill command list and the help metadata as one
# contract. Existing fixtures may predate command-help.txt; compare the two
# prose documents then, and include help metadata when it is present.
awk '$2 == "+" { path = $0; sub(/^[^ ]+ [^ ]+ /, "", path); print path }' \
    "$tmp/readme-paths" | sort -u > "$tmp/readme-command-paths"
awk '$2 == "+" { path = $0; sub(/^[^ ]+ [^ ]+ /, "", path); print path }' \
    "$tmp/skill-paths" | sort -u > "$tmp/skill-command-paths"
if [ -f "$help_metadata" ]; then
    cp "$tmp/help-paths.sorted" "$tmp/help-command-paths"
else
    : > "$tmp/help-command-paths"
fi

parse_command_flags README.md "$tmp/readme-cli.raw" > "$tmp/readme-flags.raw"
parse_command_flags SKILL.md "$tmp/skill-cli.raw" > "$tmp/skill-flags.raw"
sort -u "$tmp/readme-flags.raw" > "$tmp/readme-flags"
sort -u "$tmp/skill-flags.raw" > "$tmp/skill-flags"
sort -u "$tmp/help-flags" > "$tmp/help-flags.sorted"
mv "$tmp/help-flags.sorted" "$tmp/help-flags"

{
    cat "$tmp/readme-command-paths" "$tmp/skill-command-paths" \
        "$tmp/help-command-paths"
} | sort -u | awk '
    NR == FNR { known[$0] = 1; next }
    ($0 in known) && $0 != "help" && $0 != "--help" && $0 != "-h" { print }
' "$tmp/registry" - > "$tmp/contract-paths"

document_has_path() {
    awk -v path="$1" '$0 == path { found = 1 } END { exit !found }' "$2"
}

while IFS= read -r path; do
    for entry in "README.md|$tmp/readme-command-paths" \
                 "SKILL.md|$tmp/skill-command-paths"; do
        name=${entry%%|*}
        file=${entry#*|}
        if ! document_has_path "$path" "$file"; then
            printf '%s: command missing from doc contract: %s\n' \
                "$name" "$path" >&2
            status=1
        fi
    done
    if [ -f "$help_metadata" ] &&
       ! document_has_path "$path" "$tmp/help-command-paths"; then
        printf 'src/command-help.txt: command missing from doc contract: %s\n' \
            "$path" >&2
        status=1
    fi
done < "$tmp/contract-paths"

check_command_flag_parity() {
    parity_path=$1
    : > "$tmp/active-docs"
    for entry in "README.md|$tmp/readme-command-paths|$tmp/readme-flags" \
                 "SKILL.md|$tmp/skill-command-paths|$tmp/skill-flags" \
                 "src/command-help.txt|$tmp/help-command-paths|$tmp/help-flags"; do
        name=${entry%%|*}
        rest=${entry#*|}
        path_file=${rest%%|*}
        flag_file=${rest#*|}
        if [ "$name" = 'src/command-help.txt' ] && [ ! -f "$help_metadata" ]; then
            continue
        fi
        if document_has_path "$parity_path" "$path_file"; then
            printf '%s%s%s%s%s\n' "$name" "$tab" "$flag_file" "$tab" present \
                >> "$tmp/active-docs"
        fi
    done

    total=$(wc -l < "$tmp/active-docs" | tr -d '[:space:]')
    if [ "$total" -lt 2 ]; then
        return 0
    fi

    : > "$tmp/active-flags.raw"
    while IFS="$tab" read -r name file state; do
        awk -F '\t' -v path="$parity_path" '$1 == path { print $2 }' "$file" \
            >> "$tmp/active-flags.raw"
    done < "$tmp/active-docs"
    sort -u "$tmp/active-flags.raw" > "$tmp/active-flags"

    while IFS= read -r flag; do
        present=0
        : > "$tmp/flag-docs"
        while IFS="$tab" read -r name file state; do
            if command_has_flag "$parity_path" "$flag" "$file"; then
                present=$((present + 1))
                state=present
            else
                state=absent
            fi
            printf '%s%s%s%s%s\n' "$name" "$tab" "$file" "$tab" "$state" \
                >> "$tmp/flag-docs"
        done < "$tmp/active-docs"
        if [ "$present" -eq "$total" ]; then
            continue
        fi

        if [ "$total" -eq 2 ]; then
            second_name=$(sed -n '2p' "$tmp/active-docs" | cut -f1)
            second_file=$(sed -n '2p' "$tmp/active-docs" | cut -f2)
            first_file=$(sed -n '1p' "$tmp/active-docs" | cut -f2)
            if command_has_flag "$parity_path" "$flag" "$first_file"; then
                printf '%s: command %s is missing flag %s\n' \
                    "$second_name" "$parity_path" "$flag" >&2
            else
                printf '%s: command %s has extra flag %s\n' \
                    "$second_name" "$parity_path" "$flag" >&2
            fi
            status=1
        elif [ "$present" -ge 2 ]; then
            while IFS="$tab" read -r name file state; do
                if [ "$state" = absent ]; then
                    printf '%s: command %s is missing flag %s\n' \
                        "$name" "$parity_path" "$flag" >&2
                    status=1
                fi
            done < "$tmp/flag-docs"
        else
            while IFS="$tab" read -r name file state; do
                if [ "$state" = present ]; then
                    printf '%s: command %s has extra flag %s\n' \
                        "$name" "$parity_path" "$flag" >&2
                    status=1
                fi
            done < "$tmp/flag-docs"
        fi
    done < "$tmp/active-flags"
}

while IFS= read -r path; do
    check_command_flag_parity "$path"
done < "$tmp/contract-paths"

# The cloze rules are a documentation contract, checked by short tokens so
# wording can change without breaking lint.
cat > "$tmp/cloze-tokens" <<'EOF'
--type <basic|cloze>
{{c1::answer}}
{{c1::answer::hint}}
display time
lowercase
a marker alone
multiple markers
EOF
for doc in "$readme" "$skill"; do
    doc_name=${doc##*/}
    tr '\n' ' ' < "$doc" | tr '[:upper:]' '[:lower:]' \
        | tr -s ' ' > "$tmp/cloze-doc"
    while IFS= read -r token; do
        if ! grep -Fq -- "$token" "$tmp/cloze-doc"; then
            printf '%s: missing cloze contract text: %s\n' \
                "$doc_name" "$token" >&2
            status=1
        fi
    done < "$tmp/cloze-tokens"
done

extract_block "$readme" '## Layout' > "$tmp/layout.raw"
if [ ! -s "$tmp/layout.raw" ]; then
    printf 'Missing fenced block after ## Layout in %s\n' "$readme" >&2
    exit 1
fi

layout_tokens=0
while IFS= read -r raw; do
    lineno=${raw%%:*}
    text=${raw#*:}
    for token in $text; do
        case "$token" in
            src/*|tests/*|pkgbuild/*) ;;
            *) continue ;; # layout descriptions are prose, not paths
        esac
        layout_tokens=$((layout_tokens + 1))
        if ! layout_token_matches "$token"; then
            printf 'README.md:%s: missing Layout path: %s\n' "$lineno" "$token" >&2
            status=1
        fi
    done
done < "$tmp/layout.raw"

# Teaching pages name symbols, not source lines. They are gitignored local
# docs, so the guard runs in the self-test root instead of changing the
# integration lint result with files the branch cannot carry.
if [ "$self_test" -eq 1 ]; then
    for teaching_dir in reference lessons; do
        if [ ! -d "$teaching_dir" ]; then
            continue
        fi
        find "$teaching_dir" -type f -name '*.html' -print | sort \
            > "$tmp/teaching-pages"
        while IFS= read -r page; do
            grep -nE '#L[0-9]+|(src/)?[A-Za-z0-9_.-]+\.(cpp|h|qml|pro|txt|md):[0-9]+|lines? [0-9]+' \
                "$page" > "$tmp/anchor-matches" || true
            while IFS=: read -r line_no text; do
                anchor=$(printf '%s\n' "$text" | grep -oE \
                    '#L[0-9]+|(src/)?[A-Za-z0-9_.-]+\.(cpp|h|qml|pro|txt|md):[0-9]+|lines? [0-9]+' \
                    | head -n 1)
                printf '%s:%s: numeric source anchor: %s\n' \
                    "$page" "$line_no" "$anchor" >&2
                status=1
            done < "$tmp/anchor-matches"
        done < "$tmp/teaching-pages"
    done
fi

if [ "$status" -eq 0 ]; then
    printf 'Doc references OK (%s command paths, %s Layout path tokens)\n' \
        "$(wc -l < "$tmp/registry" | tr -d '[:space:]')" "$layout_tokens"
fi
exit "$status"
