#!/bin/sh
set -eu

# Verify that the shared Local-only parser reads a usable copy list from
# .gitignore. The optional root argument lets the self-test exercise
# synthetic repositories; the helper calls the same parser for its copies.
if [ "$#" -gt 1 ]; then
    printf 'Usage: %s [root]\n' "$0" >&2
    exit 2
fi

root=${1:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
root=$(CDPATH= cd -- "$root" && pwd)
parser="$root/bin/local-only-sync-paths.sh"
if [ ! -f "$parser" ]; then
    printf 'Missing required file: %s\n' "$parser" >&2
    exit 1
fi
. "$parser"

paths=$(local_only_sync_paths "$root")
count=$(printf '%s\n' "$paths" | wc -l | tr -d '[:space:]')
printf 'Local-only sync list OK (%s paths)\n' "$count"
