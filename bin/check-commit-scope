#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    exit 0
fi

# Read the first subject line
subject="$(sed -n '1p' "$msg_file")"

# Only enforce for docs: commits
case "$subject" in
    docs:*)
        ;;
    *)
        exit 0
        ;;
esac

# A staged C/C++ source file is allowed in a docs: commit only when every
# added or removed line is blank or a C/C++ comment line. With -U0 there is
# no context, so every '+' or '-' line inside a hunk is a changed line.
# Gating on the hunk header also keeps a source line starting with '--' or
# '++' from being mistaken for a diff file header.
comment_only_source() {
    file=$1
    git diff --cached -U0 -- "$file" | awk '
        /^@@/ { in_hunk = 1; next }
        !in_hunk { next }
        /^[-+]/ {
            line = substr($0, 2)
            sub(/^[[:space:]]+/, "", line)
            sub(/[[:space:]]+$/, "", line)
            if (line == "") next
            # "//", "/*" and "*/" after optional leading whitespace. The
            # remaining "*" branch accepts only block-comment continuations:
            # the star must be followed by whitespace or end the line, so a
            # dereference such as "*p = 1;" is source code, not a comment.
            if (line ~ /^\/\//) next
            if (line ~ /^\/\*/) next
            if (line ~ /^\*\//) next
            if (line ~ /^\*([[:space:]]|$)/) next
            bad = 1
        }
        END { exit bad }
    '
}

# Gather staged files (added/copied/modified/renamed/deleted). --name-status
# gives the change first; renames and copies carry the new path as a third
# field, which is the path the allowlist applies to. Deletions must be listed
# too, or a docs: subject could remove a source file without a single added
# or modified line.
tab="$(printf '\t')"
staged="$(git diff --cached --name-status --diff-filter=ACMRD || true)"
if [ -z "$staged" ]; then
    exit 0
fi

newline='
'
bad=""
while IFS="$tab" read -r change f renamed_to; do
    [ -z "$f" ] && continue
    if [ -n "${renamed_to:-}" ]; then
        f=$renamed_to
    fi
    case "$f" in
        docs/*) ;;
        GLOSSARY.md) ;;
        AGENTS.md) ;;
        README*|CHANGELOG*) ;;
        LICENSE) ;;
        src/*.h|src/*.cpp)
            if [ "$change" = D ]; then
                printf 'commit-msg: %s deletes a source file\n' "$f" >&2
                bad="${bad}${bad:+$newline}$f"
            elif ! comment_only_source "$f"; then
                printf 'commit-msg: %s has non-comment source changes\n' \
                    "$f" >&2
                bad="${bad}${bad:+$newline}$f"
            fi
            ;;
        */*) # files in subdirs other than docs/ and src/ are checked above
            bad="${bad}${bad:+$newline}$f" ;;
        *.md) ;; # root-level markdown
        *)
            bad="${bad}${bad:+$newline}$f" ;;
    esac
done <<EOF
$staged
EOF

if [ -n "$bad" ]; then
    printf 'commit-msg: docs: commit must only include docs files, LICENSE,\n' >&2
    printf 'root markdown and comment-only src/*.h or src/*.cpp edits.\n' >&2
    printf 'Staged files outside the allowlist, with non-comment source lines,\n' >&2
    printf 'or deleting source:\n' >&2
    printf '%s\n' "$bad" >&2
    exit 1
fi
