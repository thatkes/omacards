#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ ! -x "$ROOT/build/omacards" ]; then
    "$ROOT/bin/build"
fi
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"
qmake6 "$ROOT/tests/omacards_tests.pro"
make -j"$(nproc)"
LOG="$(mktemp "$ROOT/build/tests/run.XXXXXX")"
status=0
QT_QPA_PLATFORM=offscreen ./omacards_tests "$@" > "$LOG" 2>&1 || status=$?
cat "$LOG"
set +e
"$ROOT/bin/check-test-summary" "$LOG"
summary_status=$?
set -e
if [ "$status" -ne 0 ]; then
    exit "$status"
fi
exit "$summary_status"
