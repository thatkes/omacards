#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# --timing and --scaling are runner flags, not QtTest arguments. Remove both
# before forwarding arguments so QtTest never sees an unknown positional
# argument; rebuild "$@" one quoted word at a time to keep suite names and
# test-function selectors intact.
timing=0
scaling=0
remaining=$#
while [ "$remaining" -gt 0 ]; do
    arg=$1
    shift
    remaining=$((remaining - 1))
    if [ "$arg" = "--timing" ]; then
        timing=1
    elif [ "$arg" = "--scaling" ]; then
        scaling=1
    else
        set -- "$@" "$arg"
    fi
done

timing_lines=
now_ms() {
    nanoseconds=$(date +%s%N)
    printf '%s\n' $((nanoseconds / 1000000))
}

field_at() {
    printf '%s\n' "$1" | awk -F'|' -v n="$2" '{ print $(n + 1) }'
}

nth_word() {
    nw_wanted=$1
    nw_index=1
    # Registered suite names contain no spaces; word splitting is intentional.
    for nw_word in $2; do
        if [ "$nw_index" -eq "$nw_wanted" ]; then
            printf '%s\n' "$nw_word"
            return 0
        fi
        nw_index=$((nw_index + 1))
    done
    printf '\n'
}

record_phase() {
    rp_label=$1
    rp_start=$2
    rp_end=$3
    rp_elapsed=$((rp_end - rp_start))
    timing_lines="${timing_lines}TIMING phase ${rp_label}: ${rp_elapsed} ms
"
}

# QtTest puts the suite's own elapsed milliseconds on each Totals line. Group
# logs run suites in registry order, so the registered names from
# tests/test_main.cpp pair with those lines one by one.
emit_suite_timings() {
    esi_index=0
    for esi_log in $group_logs; do
        esi_index=$((esi_index + 1))
        esi_spec=$(field_at "$group_specs" "$esi_index")
        esi_position=1
        while IFS= read -r esi_line; do
            case "$esi_line" in
                Totals:*ms)
                    esi_ms=${esi_line##*, }
                    esi_ms=${esi_ms%ms}
                    esi_suite=$(nth_word "$esi_position" "$esi_spec")
                    if [ -n "$esi_suite" ]; then
                        timing_lines="${timing_lines}TIMING suite ${esi_suite}: ${esi_ms} ms
"
                    fi
                    esi_position=$((esi_position + 1))
                    ;;
            esac
        done < "$esi_log"
    done
}

# CLI tests spawn the app binary, so an old build would verify code that no
# longer exists. Build on every run: make skips unchanged work, and a CLI
# source edit reaches the binary before the scaling guard and suites use it.
if [ "$timing" -eq 1 ]; then
    build_start=$(now_ms)
fi
"$ROOT/bin/build"
if [ "$timing" -eq 1 ]; then
    record_phase app-build "$build_start" "$(now_ms)"
fi
# The scaling guard needs the built binary but is opt-in: local runs skip it,
# and CI adds --scaling so the #131 regression check runs once there. A skipped
# guard still emits its phase line, keeping the --timing output shape intact.
if [ "$timing" -eq 1 ]; then
    scaling_start=$(now_ms)
fi
if [ "$scaling" -eq 1 ]; then
    "$ROOT/bin/check-scaling"
fi
if [ "$timing" -eq 1 ]; then
    record_phase scaling-guard "$scaling_start" "$(now_ms)"
fi
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"
if [ "$timing" -eq 1 ]; then
    test_build_start=$(now_ms)
fi
qmake6 "$ROOT/tests/omacards_tests.pro"
make -j"$(nproc)"
if [ "$timing" -eq 1 ]; then
    record_phase test-binary-build "$test_build_start" "$(now_ms)"
fi

focused=0
for arg in "$@"; do
    if [ "$arg" = "--suite" ]; then
        focused=1
        break
    fi
done

# The test binary owns the suite registry. TestCli and TestBackend are the long
# poles, so every suite with either prefix runs alone and the rest share the
# third group. A suite registered in tests/test_main.cpp lands in a group
# without an edit here; focused runs keep their single-group contract. A timing
# run also reads the registry in focused mode so per-suite lines use the
# registered names.
cli_suites=
backend_suites=
other_suites=
suite_names=
if [ "$focused" -eq 0 ] || [ "$timing" -eq 1 ]; then
    suite_list="$(QT_QPA_PLATFORM=offscreen ./omacards_tests --list-suites)"
    case "$suite_list" in
        *'OMACARDS_TEST_MODE: info'*) ;;
        *)
            printf 'ERROR: test binary did not report info mode\n' >&2
            printf '%s\n' "$suite_list" >&2
            exit 1
            ;;
    esac
    suite_names="$(printf '%s\n' "$suite_list" | sed -n 's/^OMACARDS_TEST_SUITE: //p')"
    if [ -z "$suite_names" ]; then
        printf 'ERROR: test binary did not report suite names\n' >&2
        printf '%s\n' "$suite_list" >&2
        exit 1
    fi
fi
if [ "$focused" -eq 0 ]; then
    for suite in $suite_names; do
        case "$suite" in
            TestCli*) cli_suites="$cli_suites $suite" ;;
            TestBackend*) backend_suites="$backend_suites $suite" ;;
            *) other_suites="$other_suites $suite" ;;
        esac
    done
    if [ -z "$cli_suites" ] || [ -z "$backend_suites" ] || [ -z "$other_suites" ]; then
        printf 'ERROR: test suites did not form three groups\n' >&2
        exit 1
    fi
fi

focused_suites=
if [ "$focused" -eq 1 ] && [ "$timing" -eq 1 ]; then
    for suite in $suite_names; do
        for arg in "$@"; do
            if [ "$arg" = "$suite" ]; then
                focused_suites="$focused_suites $suite"
                break
            fi
        done
    done
fi

group_logs=
pids=
group_labels=
group_starts=
group_specs=

# The XDG cache stays on the warmed parent value: an offscreen CLI with a fresh
# cache tries to download a tectonic bundle and stalls for a minute. Every suite
# that writes SVGs points its renderer at a QTemporaryDir, and the one fixed path
# under QDir::tempPath() is isolated by the group-private TMPDIR below. State,
# decks, the installed skill and temp files each get their own group root.
shared_cache="${XDG_CACHE_HOME:-$HOME/.cache}"

run_group() {
    log=$1
    shift
    envdir="${log}.env"
    mkdir "$envdir" "$envdir/home" "$envdir/data" "$envdir/decks" "$envdir/tmp"
    HOME="$envdir/home" \
    XDG_CACHE_HOME="$shared_cache" \
    XDG_DATA_HOME="$envdir/data" \
    XDG_CONFIG_HOME="$envdir/config" \
    TMPDIR="$envdir/tmp" \
    OMACARDS_DECKS_DIR="$envdir/decks" \
    OMACARDS_STATE_DB="$envdir/state.db" \
    QT_QPA_PLATFORM=offscreen \
        ./omacards_tests "$@" > "$log" 2>&1
}

launch_group() {
    lg_label=$1
    lg_spec=$2
    shift 2
    log="$(mktemp "$ROOT/build/tests/group.XXXXXX")"
    group_logs="$group_logs $log"
    if [ "$timing" -eq 1 ]; then
        lg_start=$(now_ms)
        group_labels="${group_labels}|$lg_label"
        group_starts="${group_starts}|$lg_start"
        group_specs="${group_specs}|$lg_spec"
    fi
    run_group "$log" "$@" &
    pids="$pids $!"
}

cleanup_group_envs() {
    for log in $group_logs; do
        rm -rf "${log}.env"
    done
}

if [ "$focused" -eq 1 ]; then
    launch_group focused-group "$focused_suites" "$@"
else
    launch_group cli-group "$cli_suites" $cli_suites "$@"
    launch_group backend-group "$backend_suites" $backend_suites "$@"
    launch_group other-group "$other_suites" $other_suites "$@"
fi

status=0
group_index=0
for pid in $pids; do
    group_index=$((group_index + 1))
    set +e
    wait "$pid"
    group_status=$?
    set -e
    if [ "$status" -eq 0 ] && [ "$group_status" -ne 0 ]; then
        status=$group_status
    fi
    if [ "$timing" -eq 1 ]; then
        group_end=$(now_ms)
        group_start=$(field_at "$group_starts" "$group_index")
        group_label=$(field_at "$group_labels" "$group_index")
        record_phase "$group_label" "$group_start" "$group_end"
    fi
done

# Each group announces its own suite count. Aggregate the announcements into
# one combined log so bin/check-test-summary still sees a single run and the
# partial-run guard compares against the total number of suites.
announced_total=0
info_mode=0
for log in $group_logs; do
    if grep -q '^OMACARDS_TEST_MODE: info$' "$log"; then
        info_mode=1
    fi
    announcements="$(awk '/^OMACARDS_TEST_SUITES: [0-9]+$/ { n++ } END { print n+0 }' "$log")"
    if [ "$announcements" -ne 1 ] && [ "$info_mode" -eq 0 ]; then
        printf 'ERROR: group log did not announce exactly one suite count: %s\n' "$log" >&2
        cat "$log" >&2
        cleanup_group_envs
        exit 1
    fi
    count="$(awk '/^OMACARDS_TEST_SUITES: [0-9]+$/ { print $2 }' "$log")"
    announced_total=$((announced_total + count))
done

LOG="$(mktemp "$ROOT/build/tests/run.XXXXXX")"
if [ "$info_mode" -eq 1 ]; then
    for log in $group_logs; do
        cat "$log"
    done > "$LOG"
else
    {
        printf 'OMACARDS_TEST_SUITES: %d\n' "$announced_total"
        for log in $group_logs; do
            grep -v '^OMACARDS_TEST_SUITES: ' "$log" || true
        done
    } > "$LOG"
fi
cat "$LOG"
set +e
"$ROOT/bin/check-test-summary" "$LOG"
summary_status=$?
set -e
cleanup_group_envs

if [ "$timing" -eq 1 ]; then
    emit_suite_timings
    printf '%s' "$timing_lines"
fi

if [ "$status" -ne 0 ]; then
    exit "$status"
fi
exit "$summary_status"
