#!/usr/bin/env bash
set -euo pipefail

# Git strips comment lines before creating the commit. Check the message
# itself so an explanatory comment never blocks an otherwise valid commit.
awk '
  /^#/ { next }
  length($0) > 72 {
    printf "%s:%d: commit message line over 72 characters\n", FILENAME, FNR > "/dev/stderr"
    bad = 1
  }
  END { exit bad }
' "$1"
